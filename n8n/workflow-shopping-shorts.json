{
  "name": "Shopping Shorts - OpenClaw Webhooks",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "shopping-shorts/coupang-search",
        "responseMode": "responseNode"
      },
      "id": "wh-coupang",
      "name": "Webhook: Coupang Search",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 100]
    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst item = $input.first().json;\nconst action = item.body?.action || 'best_products';\nconst categoryId = item.body?.categoryId || '1014';\nconst limit = item.body?.limit || 10;\n\nconst ACCESS_KEY = $env.COUPANG_ACCESS_KEY;\nconst SECRET_KEY = $env.COUPANG_SECRET_KEY;\n\nconst datetime = new Date().toISOString().replace(/[-:.TZ]/g, '').slice(0, 14);\nconst method = 'GET';\nconst path = `/v2/providers/affiliate_open_api/apis/openapi/products/bestcategories/${categoryId}`;\nconst query = `limit=${limit}`;\n\nconst message = `${datetime}${method}${path}${query}`;\nconst signature = crypto.createHmac('sha256', SECRET_KEY).update(message).digest('hex');\nconst authorization = `CEA algorithm=HmacSHA256, access-key=${ACCESS_KEY}, signed-date=${datetime}, signature=${signature}`;\n\nreturn [{\n  json: {\n    url: `https://api-gateway.coupang.com${path}?${query}`,\n    headers: { Authorization: authorization }\n  }\n}];"
      },
      "id": "code-coupang-hmac",
      "name": "Coupang HMAC Sign",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [420, 100]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $json.url }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "={{ $json.headers.Authorization }}" }
          ]
        }
      },
      "id": "http-coupang",
      "name": "Coupang API Call",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [640, 100]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}"
      },
      "id": "resp-coupang",
      "name": "Respond Coupang",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [860, 100]
    },

    {
      "parameters": {
        "httpMethod": "POST",
        "path": "shopping-shorts/ghostcut-clean",
        "responseMode": "responseNode"
      },
      "id": "wh-ghostcut",
      "name": "Webhook: GhostCut",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 350]
    },
    {
      "parameters": {
        "conditions": {
          "string": [{ "value1": "={{ $json.body?.action }}", "value2": "check_status" }]
        }
      },
      "id": "if-ghostcut-action",
      "name": "Is Status Check?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [420, 350]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://open.ghostcut.com/api/open/video/submit",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "={{ $env.GHOSTCUT_API_KEY }}" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "videoUrl", "value": "={{ $json.body.videoPath }}" },
            { "name": "needChineseOcclude", "value": "={{ $json.body.options?.needChineseOcclude || 1 }}" },
            { "name": "needCrop", "value": "={{ $json.body.options?.needCrop || 0 }}" }
          ]
        }
      },
      "id": "http-ghostcut-submit",
      "name": "GhostCut Submit",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [640, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://open.ghostcut.com/api/open/video/query?taskId={{ $json.body.taskId }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "={{ $env.GHOSTCUT_API_KEY }}" }
          ]
        }
      },
      "id": "http-ghostcut-status",
      "name": "GhostCut Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [640, 420]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}"
      },
      "id": "resp-ghostcut",
      "name": "Respond GhostCut",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [860, 350]
    },

    {
      "parameters": {
        "httpMethod": "POST",
        "path": "shopping-shorts/deploy-youtube",
        "responseMode": "responseNode"
      },
      "id": "wh-youtube",
      "name": "Webhook: YouTube",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 600]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://www.googleapis.com/upload/youtube/v3/videos?part=snippet,status&uploadType=multipart",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.YOUTUBE_ACCESS_TOKEN }}" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "snippet.title", "value": "={{ $json.body.title }}" },
            { "name": "snippet.description", "value": "={{ $json.body.description }}" },
            { "name": "snippet.categoryId", "value": "={{ $json.body.categoryId || '22' }}" },
            { "name": "status.privacyStatus", "value": "={{ $json.body.privacyStatus || 'public' }}" }
          ]
        }
      },
      "id": "http-youtube",
      "name": "YouTube Upload",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [420, 600]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: true, videoId: $json.id, url: 'https://youtube.com/shorts/' + $json.id }) }}"
      },
      "id": "resp-youtube",
      "name": "Respond YouTube",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [640, 600]
    },

    {
      "parameters": {
        "httpMethod": "POST",
