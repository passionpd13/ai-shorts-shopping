# ==========================================
# 쇼핑 쇼츠 자동화 — 환경 변수
# ==========================================
# .env.example을 .env로 복사 후 값을 채우세요
# cp .env.example .env && nano .env

# ---- AI Models ----
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# ---- TTS ----
SUPERTONE_API_KEY=

# ---- Telegram (제어 + 알림) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- n8n ----
N8N_USER=admin
N8N_PASSWORD=changeme
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5678

# ---- 쿠팡 파트너스 ----
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=

# ---- GhostCut (자막/워터마크 제거) ----
GHOSTCUT_API_KEY=

# ---- YouTube (OAuth2 — n8n Credentials에서 설정) ----
YOUTUBE_ACCESS_TOKEN=

# ---- Instagram / Facebook ----
INSTAGRAM_BUSINESS_ID=
INSTAGRAM_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=

# ---- TikTok ----
TIKTOK_ACCESS_TOKEN=

# ---- Google Sheets ----
GOOGLE_SHEETS_ID=
